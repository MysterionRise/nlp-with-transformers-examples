# Copy to .env for local development.
# The demo key is for local portfolio demos only. Replace all values for shared or public deployments.

NLP_LOG_LEVEL=INFO
NLP_JSON_LOGS=true
NLP_MAX_CACHED_MODELS=3
NLP_REDIS_URL=redis://redis:6379/0
NLP_OTEL_ENABLED=false

NLP_API__JWT_SECRET=replace-with-a-long-random-secret
NLP_API__API_KEYS={"demo-customer-intel-key":{"name":"Portfolio Demo","role":"admin","rate_limit":1000,"enabled":true}}
NLP_API__CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
